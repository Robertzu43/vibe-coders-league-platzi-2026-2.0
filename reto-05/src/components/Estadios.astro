---
import { venues } from '../data/worldcup';
import { scaleLinear, formatInt } from '../lib/chart';

const maxAttendance = Math.max(...venues.map((v) => v.attendance));
const heightScale = scaleLinear([0, maxAttendance], [0, 220]);
---
<div class="viz-block">
  <h3>Asistencias históricas</h3>
  <p class="viz-note">Las asistencias más grandes en la historia del Mundial. Elige una sede para ver el dato.</p>

  <ol id="estadios-bars" class="bars-v" role="list">
    {venues.map((v) => {
      const h = heightScale(v.attendance);
      return (
        <li
          class="bar-col"
          role="button"
          tabindex="0"
          data-note={v.note}
          aria-label={`${v.name} ${v.year}: ${formatInt(v.attendance)} asistentes. ${v.note}`}
        >
          <span class="bar-value">{formatInt(v.attendance)}</span>
          <span class="bar-vfill" style={`height:${h}px`}></span>
          <span class="bar-vlabel">{v.name}<br />{v.year}</span>
        </li>
      );
    })}
  </ol>

  <p id="estadios-note" aria-live="polite" class="note">Elige una sede para ver el dato.</p>

  <details>
    <summary>Ver datos en tabla</summary>
    <table>
      <thead><tr><th>Estadio</th><th>Ciudad</th><th>Año</th><th>Asistencia</th><th>Nota</th></tr></thead>
      <tbody>
        {venues.map((v) => (
          <tr>
            <td>{v.name}</td>
            <td>{v.city}</td>
            <td>{v.year}</td>
            <td>{formatInt(v.attendance)}</td>
            <td>{v.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</div>
<style>
  .viz-note { max-width: 42ch; color: var(--ink-soft); margin: 0 0 12px; font-size: 14px; }
  .bars-v { list-style: none; padding: 0; margin: 18px 0; display: flex; align-items: flex-end;
            gap: 18px; min-height: 260px; }
  .bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
             gap: 6px; cursor: pointer; flex: 1; }
  .bar-value { font-weight: 700; font-size: 14px; }
  .bar-vfill { display: block; width: 100%; max-width: 64px; border-radius: 6px 6px 0 0;
               background: var(--red); opacity: .75; transition: opacity .2s, background .2s; }
  .bar-col.active .bar-vfill, .bar-col:hover .bar-vfill, .bar-col:focus-visible .bar-vfill { opacity: 1; }
  .bar-vlabel { font-size: 12px; text-align: center; color: var(--ink-soft); line-height: 1.3; }
  .note { min-height: 20px; padding: 10px 14px; border-radius: var(--radius-sm); background: var(--paper-2);
          border: 1px solid var(--line); font-size: 14px; }
  table { border-collapse: collapse; margin-top: 10px; }
  td, th { border: 1px solid var(--line); padding: 4px 10px; text-align: left; }
</style>
<script>
  import { initEstadios } from '../scripts/estadios';
  initEstadios();
</script>
