---
// Footer — marca Órbita + contacto.
const year = 2026;
---

<footer class="footer">
  <div class="contenedor footer__grid">
    <div>
      <span class="footer__brand">Órbita</span>
      <p class="footer__tag">Web &amp; automatización para negocios que quieren crecer sin complicarse.</p>
    </div>
    <div class="footer__contact">
      <a href="mailto:hola@orbita.studio">hola@orbita.studio</a>
      <span aria-hidden="true">·</span>
      <a href="#diagnostico">Hacer el diagnóstico</a>
    </div>
  </div>
  <div class="contenedor footer__legal">
    <span>© {year} Órbita · Radar Digital</span>
    <span>Hecho con Claude Code · Vibe Coders League</span>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--canvas); padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) 1.6rem; margin-top: clamp(3rem, 2rem + 4vw, 6rem); }
  .footer__grid { display: flex; flex-wrap: wrap; gap: 1.6rem 3rem; justify-content: space-between; align-items: flex-start; }
  .footer__brand { font-family: var(--font-display); font-size: 1.9rem; font-weight: 600; }
  .footer__tag { color: rgba(242, 238, 226, 0.7); max-width: 34ch; margin-top: 0.4rem; }
  .footer__contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; font-weight: 600; }
  .footer__contact a { color: var(--lime); text-decoration: none; }
  .footer__contact a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .footer__contact span { color: rgba(242, 238, 226, 0.4); }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; margin-top: 2.4rem; padding-top: 1.4rem; border-top: 1px solid rgba(242, 238, 226, 0.15); font-size: 0.82rem; color: rgba(242, 238, 226, 0.55); }
</style>
