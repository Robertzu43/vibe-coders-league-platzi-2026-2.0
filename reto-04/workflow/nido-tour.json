    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const NL = String.fromCharCode(10);\nconst DIRECCION = 'Nido - Cra. 13 #93-40, Chapinero, Bogota';\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const nombre = String(j['Nombre completo'] || '').trim();\n  const email = String(j['Correo'] || '').trim();\n  const empresa = String(j['Empresa'] || '').trim();\n  const diaTour = String(j['Día preferido del tour'] || '').trim();\n  const mensaje = String(j['Mensaje'] || '').trim();\n  const n = Number(j['Tamaño del equipo']);\n  let segmento; let plan; let prioridad; let incierta = false;\n  if (!Number.isFinite(n) || n < 1) { segmento = 'Independiente'; plan = 'Hot-desk flexible'; prioridad = 'Normal'; incierta = true; }\n  else if (n <= 2) { segmento = 'Independiente'; plan = 'Hot-desk flexible'; prioridad = 'Normal'; }\n  else if (n <= 8) { segmento = 'Equipo pequeño'; plan = 'Oficina privada'; prioridad = 'Alta'; }\n  else { segmento = 'Enterprise'; plan = 'Piso dedicado'; prioridad = 'Hot lead'; }\n  const primer = nombre.split(' ')[0] || nombre;\n  const equipoTxt = Number.isFinite(n) ? String(n) : 's/d';\n  const emailSubject = 'Tu tour en Nido esta confirmado, ' + primer;\n  const emailBody = [\n    'Hola ' + primer + ',',\n    '',\n    'Gracias por agendar tu tour en Nido. Te esperamos el ' + (diaTour || 'dia acordado') + ' en:',\n    DIRECCION,\n    '',\n    'Segun nos contaste (equipo de ' + equipoTxt + '), creemos que el plan ideal para ti es:',\n    plan + ' (' + segmento + ')',\n    '',\n    'En la visita te mostramos el espacio, resolvemos tus dudas y armamos una propuesta a tu medida.',\n    '',\n    'Nos vemos pronto,',\n    'El equipo de Nido'\n  ].join(NL);\n  const hot = prioridad === 'Hot lead';\n  const t = [];\n  t.push((hot ? 'HOT LEAD - ' : '') + 'Nuevo tour agendado en Nido');\n  t.push('Nombre: ' + nombre);\n  t.push('Empresa: ' + (empresa || '-'));\n  t.push('Correo: ' + email);\n  t.push('Equipo: ' + equipoTxt + ' personas');\n  t.push('Dia del tour: ' + (diaTour || 's/d'));\n  t.push('Segmento: ' + segmento);\n  t.push('Plan sugerido: ' + plan);\n  t.push('Prioridad: ' + prioridad);\n  if (incierta) { t.push('Clasificacion incierta - revisar'); }\n  if (mensaje) { t.push('Mensaje: ' + mensaje); }\n  const telegramText = t.join(NL);\n  out.push({ json: { timestamp: new Date().toISOString(), nombre: nombre, email: email, empresa: empresa, tamano_equipo: Number.isFinite(n) ? n : '', dia_tour: diaTour, segmento: segmento, plan_sugerido: plan, prioridad: prioridad, clasificacion_incierta: incierta, mensaje: mensaje, emailSubject: emailSubject, emailBody: emailBody, telegramText: telegramText } });\n}\nreturn out;\n"
      },
